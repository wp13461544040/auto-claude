# moemail 临时邮箱
MOEMAIL_API_KEY=mk_your_api_key_here
MOEMAIL_BASE_URL=https://your-moemail-instance.example.com

# 出口代理配置
# 
# 方式 1：从 proxy.text 文件读取（推荐，每行一个代理）
#   格式：用户名:密码@主机:端口 或 socks5://用户名:密码@主机:端口
#   示例：
#     user:pass@proxy.example.com:1080
#     socks5h://user:pass@proxy.example.com:1080
#   注：不带协议头的自动加 socks5:// 前缀
#
# 方式 2：从环境变量读取（兼容旧版）
#   单个代理：PROXY=socks5h://user:pass@host:port
#   多个代理：PROXY=socks5h://proxy1:port,socks5h://proxy2:port,http://proxy3:port
#
# 支持协议：http://, https://, socks5://, socks5h://
# socks5h:// 表示 DNS 也走代理解析，避免本地 DNS 泄漏

# 批量注册
REGISTER_COUNT=1          # 默认注册账号数量
REGISTER_CONCURRENT=1     # 默认并发数

# 账号文件
# ACCOUNTS_FILE=accounts.json
